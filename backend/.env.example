# Copy to backend/.env — never commit .env
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://watcher:watcher-dev-only@localhost:5432/watcher

CLIENT_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
ENROLL_ORIGIN=http://localhost:5175

# false ONLY for local http development; must be true in production (HTTPS)
COOKIE_SECURE=false
# "strict" for same-origin/dev; "none" when sites are on a different domain than the API (needs HTTPS)
COOKIE_SAMESITE=strict
CLIENT_SESSION_HOURS=8

MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10/minute

# Fictional demo profile — choose your own 4–12 digit PIN
DEMO_PROJECT_ID=demo-0000
DEMO_PIN=

# Used from Phase 10 (Nominatim requires an identifying User-Agent, max 1 req/s)
GEOCODER_USER_AGENT=WATCHER/0.10 (contact: you@example.com)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
ENROLL_RATE_LIMIT=5/hour
MIN_OWNER_AGE=18
CONFIDENTIAL_MINUTES=15
GEOCODER_ENABLED=true
GEOCODER_URL=https://nominatim.openstreetmap.org/search
